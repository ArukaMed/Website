# ==============================================================================
# AEGIS-B2B ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env or .env.local and populate the secrets for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon Serverless PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Connection string with pooled connection support
DATABASE_URL="postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/aegis_db?sslmode=require"

# ------------------------------------------------------------------------------
# 2. EDGE KEY-VALUE CACHE (Upstash Redis)
# ------------------------------------------------------------------------------
# Used by Edge Middleware for <5ms hostname-to-tenant resolution
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# ------------------------------------------------------------------------------
# 3. DOMAIN & HOSTNAME CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ROOT_DOMAIN="arukamed.com"
NEXT_PUBLIC_MARKETING_URL="http://localhost:3000"
NEXT_PUBLIC_CARD_URL="http://localhost:3001"
NEXT_PUBLIC_ADMIN_HOST="admin.arukamed.com"
NEXT_PUBLIC_OPS_HOST="ops.arukamed.com"
NEXT_PUBLIC_CARD_HOST="c.arukamed.com"

# ------------------------------------------------------------------------------
# 4. INTERNAL SECURITY & REVALIDATION TOKENS
# ------------------------------------------------------------------------------
INTERNAL_API_SECRET="change_me_to_a_secure_random_64_character_string_for_internal_apis"
INTERNAL_REVALIDATE_SECRET="change_me_to_a_secure_random_token_for_edge_revalidation"

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# For wholesale PDF catalogs, avatars, and 300 DPI CMYK print PDFs
STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="your_r2_access_key_id"
STORAGE_SECRET_ACCESS_KEY="your_r2_secret_access_key"
STORAGE_BUCKET_NAME="aegis-tenant-assets"
STORAGE_PUBLIC_DOMAIN="https://assets.arukamed.com"

# ------------------------------------------------------------------------------
# 6. AUTHENTICATION & MULTI-TENANT RBAC (Clerk / Better-Auth)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_sample_clerk_key"
CLERK_SECRET_KEY="sk_test_sample_clerk_secret"

# If using Better-Auth alternative:
BETTER_AUTH_SECRET="your_32_character_random_auth_secret_key"
BETTER_AUTH_URL="http://localhost:3002"

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL COMMUNICATIONS (Resend / AWS SES / WhatsApp)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_sample_resend_api_key"
SYSTEM_FROM_EMAIL="Aruka Med Trade Desk <orders@arukamed.com>"

# Optional WhatsApp Cloud API / Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""

# ------------------------------------------------------------------------------
# 8. ANALYTICS & MONITORING (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
SENTRY_DSN=""

